#include "resource.h"

1 RT_MANIFEST "app.manifest"

IDR_ISRG_ROOT_X1 RCDATA "isrgrootx1.der"

IDI_APP_ICON ICON "app.ico"
IDB_HEADER_BG BITMAP "header_bg.bmp"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DM Team"
            VALUE "FileDescription", "LunaPassport Patcher for Windows XP"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "lunapassport-patcher"
            VALUE "LegalCopyright", "Copyright (C) 2026 DM Team"
            VALUE "OriginalFilename", "lunapassport-patcher.exe"
            VALUE "ProductName", "LunaPassport Patcher"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
